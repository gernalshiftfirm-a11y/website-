# =======================================================================
# Jindal Dental Clinic — Environment Variables
# Copy this file to `.env` for local dev, or paste into Netlify dashboard:
#   Site settings → Build & deploy → Environment → Environment variables
# =======================================================================

# ---- Supabase (REQUIRED) -----------------------------------------------
# Get these from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx-server-only-never-expose-to-browser

# These two are safe in browser code (used by /admin)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJxxxx-anon-key

# ---- Clinic contact (REQUIRED) -----------------------------------------
CLINIC_PHONE=+919815171917
CLINIC_EMAIL=contact@jindaldentalclinic.in
CLINIC_NAME=Jindal Dental Clinic

# ---- Email notifications via Resend (OPTIONAL but recommended) ---------
# Free tier: 100 emails/day, 3000/month. Sign up: https://resend.com
# If empty, the function still saves bookings and returns success — but
# the clinic won't get email alerts. Set this ASAP.
RESEND_API_KEY=
# The "from" address must be a domain verified in Resend.
# Until you verify a domain, use the Resend test address:
#   onboarding@resend.dev
RESEND_FROM=Jindal Dental Clinic <onboarding@resend.dev>

# ---- WhatsApp Cloud API (OPTIONAL — Tier 2) ----------------------------
# Leave EMPTY for now. Once you have Meta Business verification + an
# approved template, fill these in and WhatsApp becomes fully automatic.
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Names of pre-approved Meta templates (in your WhatsApp Business Manager)
WHATSAPP_TEMPLATE_PATIENT=appointment_confirmation
WHATSAPP_TEMPLATE_CLINIC=new_appointment_alert
